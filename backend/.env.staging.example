# FIL staging environment template (Laravel Forge)
# Copy to Forge → Site → Environment, replace placeholders, then run:
#   php artisan config:cache && php artisan mvp:staging-check
#
# Gate reference: docs/MVP_DEPLOY.md · Operator checklist: docs/FORGE_STAGING_CHECKLIST.md

APP_NAME=FIL
APP_ENV=staging
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://fil.on-forge.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=info

# --- Database (Forge PostgreSQL on same VPS) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fil_staging
DB_USERNAME=forge
DB_PASSWORD=CHANGE_ME

# --- Queue / cache / sessions (minimal stack — no Redis) ---
QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Auth (Sanctum SPA) ---
# Must include APP_URL host (no scheme). Comma-separated.
SANCTUM_STATEFUL_DOMAINS=fil.on-forge.com

# --- Widget embed (required in staging) ---
# Client marketing site origins — comma-separated, no trailing slash.
FIL_EMBED_ALLOWED_ORIGINS=https://www.clientdomain.com,https://clientdomain.com
# Client-specific keys from Settings → Widget form (pk_live_*). Never pk_dev.
FIL_EMBED_SITE_KEYS=pk_live_REPLACE_WITH_CLIENT_KEY
FIL_EMBED_SITE_KEY_RATE_LIMIT=30

# --- Mail (Mailgun sandbox OK for staging) ---
MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS="noreply@mg.clientdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=mg.clientdomain.com
MAILGUN_SECRET=CHANGE_ME
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=CHANGE_ME

# --- Content Security Policy (SEC-020) ---
# Enabled by default outside local. Use report-only first when tuning Plaid/Dwolla.
FIL_CSP_ENABLED=true
FIL_CSP_REPORT_ONLY=true
# Override only if browser console shows CSP violations after ACH/FDD flows:
# FIL_CSP_SCRIPT_SRC=https://cdn.plaid.com,https://cdn.dwolla.com,https://www.google.com,https://www.gstatic.com
# FIL_CSP_CONNECT_SRC=https://*.plaid.com,https://*.dwolla.com,https://www.google.com
# FIL_CSP_FRAME_SRC=https://www.google.com,https://recaptcha.google.com

# --- Optional integrations (leave empty until sandbox keys available) ---
FIL_AI_SERVICE_URL=
FIL_RECAPTCHA_SITE_KEY=
FIL_RECAPTCHA_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_TOKEN=
DWOLLA_ENVIRONMENT=sandbox
DWOLLA_WEBHOOK_SECRET=CHANGE_ME_BEFORE_ACH_TESTING
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=https://fil.on-forge.com/api/webhooks/plaid

# --- Observability (Phase 5) ---
# SENTRY_LARAVEL_DSN=
# VITE_SENTRY_DSN=   # set at frontend build time in Forge deploy if using Sentry

# --- Legacy import (Phase 4 — staging only) ---
FIL_LEGACY_DUMP_PATH=/home/forge/imports/client-dump.sql.gz
FIL_LEGACY_TABLE_PREFIX=vnzokz0zw_9_
