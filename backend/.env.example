APP_NAME=FIL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fil
DB_USERNAME=fil
DB_PASSWORD=fil

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production/staging (HTTPS) MUST set: SESSION_SECURE_COOKIE=true and
# consider SESSION_ENCRYPT=true. mvp:staging-check fails if these are not hardened.
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FIL_NOTIFICATIONS_QUEUE=notifications
FIL_EMAILS_QUEUE=emails
FIL_NOTIFICATION_DEV_EMAILS=
FIL_NOTIFICATION_MAX_RECIPIENTS=50

CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Outbound mail safety (non-production): never sends to real recipients.
# MAIL_MAILER=log is recommended locally. Recipients are rewritten to FIL_MAIL_SINK
# (or mail-sink@fil.invalid when unset). Production only sends to real addresses.
FIL_MAIL_SINK=
# FIL_MAIL_NON_PRODUCTION_MAILER=log
# FIL_MAIL_BLOCK_OUTBOUND=false

VITE_APP_NAME="${APP_NAME}"

# FIL product
# Optional: external AI service (Cloud Run or similar proxy)
# When set, POST /interpret-grid and /chat are used for NL search + assistant.
FIL_AI_SERVICE_URL=
FIL_EMBED_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Comma-separated browser origins allowed to POST leads in staging/production
# (client marketing sites). FIL app origin is always allowed for staff preview.
# Optional extra allowlist (local seed uses pk_dev). Active widget-form site keys
# in the database are also accepted — no .env edit needed when creating forms in Settings.
FIL_EMBED_SITE_KEYS=pk_dev
# Per site_key submissions/min on public lead intake (staging/production). Default 30.
FIL_EMBED_SITE_KEY_RATE_LIMIT=30
# Content-Security-Policy for staff SPA (auto-enabled outside local). Empty = default on.
FIL_CSP_ENABLED=
FIL_CSP_REPORT_ONLY=false
# Optional tenant branding (overridden by client_settings when set in DB)
FIL_BRAND_LOGO_URL=
FIL_FAVICON_URL=
FIL_RECAPTCHA_SITE_KEY=
FIL_RECAPTCHA_SECRET_KEY=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000
FIL_LEGACY_DUMP_PATH=../data/local.sql.gz
FIL_LEGACY_TABLE_PREFIX=vnzokz0zw_9_

# Production integrations (Forge staging)
# Set MAIL_MAILER=mailgun and configure domain credentials for production email.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_TOKEN=
DWOLLA_ENVIRONMENT=sandbox
DWOLLA_WEBHOOK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=
